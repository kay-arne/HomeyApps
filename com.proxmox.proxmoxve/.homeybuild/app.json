      {
        "id": "cpu_usage_above",
        "title": {
          "en": "CPU usage is above a threshold",
          "nl": "CPU-gebruik is boven een grenswaarde"
        },
        "titleFormatted": {
          "en": "CPU usage is above [[threshold]] %",
          "nl": "CPU-gebruik is boven [[threshold]] %"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=proxmox-node"
          },
          {
            "name": "threshold",
            "type": "number",
            "title": {
              "en": "Threshold (%)",
              "nl": "Grenswaarde (%)"
            },
            "min": 0,
            "max": 100,
            "step": 1
          }
        ],
        "tokens": [
          {
            "name": "value",
            "type": "number",
            "title": {
              "en": "CPU Usage (%)",
              "nl": "CPU-gebruik (%)"
            },
            "example": 87.5
          }
        ]
      },
      {
        "id": "memory_usage_above",
        "title": {
          "en": "Memory usage is above a threshold",
          "nl": "Geheugengebruik is boven een grenswaarde"
        },
        "titleFormatted": {
          "en": "Memory usage is above [[threshold]] %",
          "nl": "Geheugengebruik is boven [[threshold]] %"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=proxmox-node"
