  "flow": {
    "conditions": [
      {
        "id": "node_is_online",
        "title": {
          "en": "Node is online",
          "nl": "Node is online"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=proxmox-node"
          }
        ]
      },
      {
        "id": "vm_is_running",
        "title": {
          "en": "VM/Container is running",
          "nl": "VM/Container draait"
        },
        "titleFormatted": {
          "en": "[[target_vm]] is running",
          "nl": "[[target_vm]] draait"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=proxmox-cluster"
          },
          {
            "name": "target_vm",
