          {
            "name": "threshold",
            "type": "number",
            "title": {
              "en": "Threshold (%)",
              "nl": "Grenswaarde (%)"
            },
            "min": 0,
            "max": 100,
            "step": 1
          }
        ],
        "tokens": [
          {
            "name": "value",
            "type": "number",
            "title": {
              "en": "Memory Usage (%)",
              "nl": "Geheugengebruik (%)"
            },
            "example": 62.3
          }
        ]
      }
