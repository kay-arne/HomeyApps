{
  "name": {
    "en": "Proxmox VM/Container",
    "nl": "Proxmox VM/Container"
  },
  "class": "other",
  "capabilities": [
    "onoff",
    "measure_cpu_usage_perc",
    "measure_memory_usage_perc"
  ],
  "$extends": [
    "defaults"
  ],
  "settings": [
    {
      "id": "poll_interval_vm",
      "type": "dropdown",
      "label": {
        "en": "Polling Interval",
        "nl": "Polling Interval"
      },
      "hint": {
        "en": "Update interval for this VM/Container's status, 0 disables polling.",
        "nl": "Update interval voor de status van deze VM/Container, 0 schakelt polling uit."
      },
      "value": "1",
      "values": [
        {
          "id": "0",
          "label": {
            "en": "Disabled",
            "nl": "Uitgeschakeld"
          }
        },
        {
          "id": "0.5",
          "label": {
            "en": "30 Seconds",
            "nl": "30 Seconden"
          }
        },
        {
          "id": "1",
          "label": {
            "en": "1 Minute",
            "nl": "1 Minuut"
          }
        },
        {
          "id": "5",
          "label": {
            "en": "5 Minutes",
            "nl": "5 Minuten"
          }
        },
        {
          "id": "10",
          "label": {
            "en": "10 Minutes",
            "nl": "10 Minuten"
          }
        }
      ]
    }
  ],
  "pair": [
    {
      "id": "list_all_vms",
      "template": "list_devices",
      "title": {
        "en": "Select VM(s)/Container(s) to Add",
        "nl": "Selecteer VM('s)/Container(s) om Toe te Voegen"
      },
      "navigation": {
        "next": "add_devices"
      },
      "options": {
        "showLoader": true
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
