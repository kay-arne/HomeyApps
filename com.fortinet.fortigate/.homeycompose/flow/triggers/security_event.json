{
  "title": {
    "en": "A security event was reported"
  },
  "titleFormatted": {
    "en": "Reports a security event"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=fortigate"
    }
  ],
  "tokens": [
    {
      "name": "type",
      "type": "string",
      "title": { "en": "Type" },
      "example": "ips"
    },
    {
      "name": "severity",
      "type": "string",
      "title": { "en": "Severity" },
      "example": "critical"
    },
    {
      "name": "message",
      "type": "string",
      "title": { "en": "Message" },
      "example": "Malicious.URL blocked"
    },
    {
      "name": "srcip",
      "type": "string",
      "title": { "en": "Source IP" },
      "example": "192.168.1.42"
    },
    {
      "name": "dstip",
      "type": "string",
      "title": { "en": "Destination IP" },
      "example": "203.0.113.9"
    }
  ]
}
