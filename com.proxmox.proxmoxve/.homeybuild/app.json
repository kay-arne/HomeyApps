          "en": "Reboot [[target_vm]]",
          "nl": "Herstart [[target_vm]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=proxmox-cluster"
          },
          {
            "name": "target_vm",
            "type": "autocomplete",
            "title": {
              "en": "VM/Container",
              "nl": "VM/Container"
            },
            "placeholder": {
              "en": "Type to search...",
              "nl": "Typ om te zoeken..."
            }
          }
        ]
      },
      {
        "id": "migrate_vm",
        "title": {
          "en": "Migrate VM/Container",
          "nl": "VM/Container Migreren"
        },
        "titleFormatted": {
          "en": "Migrate [[target_vm]] to [[target_node]]",
          "nl": "Migreer [[target_vm]] naar [[target_node]]"
        },
        "hint": {
          "en": "Moves the VM/Container to another node in the same cluster. Requires shared storage for a running VM/Container, unless the storage is already available on the target node.",
          "nl": "Verplaatst de VM/Container naar een andere node in hetzelfde cluster. Vereist gedeelde opslag voor een draaiende VM/Container, tenzij de opslag al beschikbaar is op de doelnode."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=proxmox-cluster"
          },
          {
            "name": "target_vm",
            "type": "autocomplete",
            "title": {
              "en": "VM/Container",
              "nl": "VM/Container"
            },
            "placeholder": {
              "en": "Type to search...",
              "nl": "Typ om te zoeken..."
            }
          },
          {
            "name": "target_node",
            "type": "autocomplete",
            "title": {
              "en": "Target Node",
              "nl": "Doelnode"
            },
            "placeholder": {
              "en": "Type to search for a node...",
              "nl": "Typ om een node te zoeken..."
            }
          }
        ]
      },
      {
        "id": "shutdown_node",
        "title": {
          "en": "Shutdown Node (Graceful)",
          "nl": "Node Uitschakelen (Graceful)"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=proxmox-node"
          }
        ]
      },
      {
        "id": "stop_node",
        "title": {
          "en": "Force Stop all VMs/Containers on Node",
          "nl": "Forceer Stop alle VM's/Containers op Node"
        },
        "hint": {
          "en": "Immediately kills every running VM/Container on this node. Proxmox has no remote 'force power off' for the node itself, only for VMs/Containers, so this stops everything running on it instead. Risk of data loss - prefer Shutdown Node when possible.",
          "nl": "Beëindigt onmiddellijk elke draaiende VM/Container op deze node. Proxmox heeft geen externe 'forceer uitschakelen' voor de node zelf, alleen voor VM's/Containers, dus dit stopt in plaats daarvan alles wat erop draait. Risico op dataverlies - gebruik indien mogelijk Node Uitschakelen."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=proxmox-node"
          }
        ]
      },
      {
        "id": "reboot_node",
