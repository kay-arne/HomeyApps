        "tokens": [
          {
            "name": "name",
            "type": "string",
            "title": {
              "en": "Name",
              "nl": "Naam"
            },
            "example": "Media-Server"
          },
          {
            "name": "vmid",
            "type": "number",
            "title": {
              "en": "VM/Container ID",
              "nl": "VM/Container ID"
            },
            "example": 105
